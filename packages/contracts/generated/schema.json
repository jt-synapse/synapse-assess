{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AssessmentManifest",
  "$defs": {
    "AIReply": {
      "additionalProperties": false,
      "properties": {
        "interaction_id": {
          "format": "uuid",
          "title": "Interaction Id",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "interaction_id",
        "model",
        "content"
      ],
      "title": "AIReply",
      "type": "object"
    },
    "AIRequest": {
      "additionalProperties": false,
      "properties": {
        "messages": {
          "items": {
            "$ref": "#/$defs/UserMessage"
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RepositoryContext"
        }
      },
      "required": [
        "messages",
        "context"
      ],
      "title": "AIRequest",
      "type": "object"
    },
    "ActiveStage": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Stage Id",
          "type": "string"
        },
        "stage_attempt_id": {
          "format": "uuid",
          "title": "Stage Attempt Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "ai_enabled": {
          "title": "Ai Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "stage_id",
        "stage_attempt_id",
        "started_at",
        "deadline_at",
        "ai_enabled"
      ],
      "title": "ActiveStage",
      "type": "object"
    },
    "ArtifactSpec": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ArtifactSpec",
      "type": "object"
    },
    "AssessmentManifest": {
      "additionalProperties": false,
      "description": "Trusted package metadata. Drafts can identify artifacts pending publication.",
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "package_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Package Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeSpec"
        },
        "services": {
          "items": {
            "const": "postgresql",
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StagePolicy"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "candidate_artifact": {
          "$ref": "#/$defs/ArtifactSpec"
        },
        "evaluator_artifact": {
          "$ref": "#/$defs/ArtifactSpec"
        }
      },
      "required": [
        "schema_version",
        "package_id",
        "version",
        "title",
        "runtime",
        "services",
        "stages",
        "candidate_artifact",
        "evaluator_artifact"
      ],
      "title": "AssessmentManifest",
      "type": "object"
    },
    "AudioAck": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "audio_ack",
          "title": "Type",
          "type": "string"
        },
        "stream_id": {
          "format": "uuid",
          "title": "Stream Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "stream_id",
        "sequence"
      ],
      "title": "AudioAck",
      "type": "object"
    },
    "AudioChunk": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "audio_chunk",
          "title": "Type",
          "type": "string"
        },
        "stream_id": {
          "format": "uuid",
          "title": "Stream Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "audio_base64": {
          "maxLength": 131072,
          "minLength": 4,
          "title": "Audio Base64",
          "type": "string"
        }
      },
      "required": [
        "type",
        "stream_id",
        "sequence",
        "start_ms",
        "audio_base64"
      ],
      "title": "AudioChunk",
      "type": "object"
    },
    "CreateSession": {
      "additionalProperties": false,
      "properties": {
        "invitation_id": {
          "format": "uuid",
          "title": "Invitation Id",
          "type": "string"
        }
      },
      "required": [
        "invitation_id"
      ],
      "title": "CreateSession",
      "type": "object"
    },
    "DefenseAnswer": {
      "additionalProperties": false,
      "properties": {
        "client_operation_id": {
          "format": "uuid",
          "title": "Client Operation Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "question_id": {
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        }
      },
      "required": [
        "client_operation_id",
        "text",
        "question_id"
      ],
      "title": "DefenseAnswer",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "EventPage": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/EvidenceEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "events",
        "next_cursor"
      ],
      "title": "EventPage",
      "type": "object"
    },
    "EvidenceEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "server_sequence": {
          "exclusiveMinimum": 0,
          "title": "Server Sequence",
          "type": "integer"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "stage_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stage Id"
        },
        "stage_attempt_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stage Attempt Id"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "source": {
          "enum": [
            "browser",
            "control_plane",
            "sandbox_broker",
            "ai_gateway",
            "transcription",
            "evaluator",
            "reviewer"
          ],
          "title": "Source",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "exclusiveMinimum": 0,
          "title": "Schema Version",
          "type": "integer"
        },
        "deduplication_id": {
          "format": "uuid",
          "title": "Deduplication Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "artifact_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        }
      },
      "required": [
        "event_id",
        "server_sequence",
        "session_id",
        "stage_id",
        "stage_attempt_id",
        "event_type",
        "source",
        "occurred_at",
        "received_at",
        "schema_version",
        "deduplication_id",
        "payload"
      ],
      "title": "EvidenceEvent",
      "type": "object"
    },
    "EvidenceReceipt": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "server_sequence": {
          "exclusiveMinimum": 0,
          "title": "Server Sequence",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "server_sequence"
      ],
      "title": "EvidenceReceipt",
      "type": "object"
    },
    "EvidenceValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/EvidenceValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ExecutionRequest": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "minLength": 1,
          "title": "Command Id",
          "type": "string"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        },
        "client_operation_id": {
          "format": "uuid",
          "title": "Client Operation Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "workspace_revision",
        "client_operation_id"
      ],
      "title": "ExecutionRequest",
      "type": "object"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "format": "uuid",
          "title": "Execution Id",
          "type": "string"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "TIMED_OUT",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "stdout_artifact_id": {
          "format": "uuid",
          "title": "Stdout Artifact Id",
          "type": "string"
        },
        "stderr_artifact_id": {
          "format": "uuid",
          "title": "Stderr Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "workspace_revision",
        "command",
        "status",
        "exit_code",
        "duration_ms",
        "stdout_artifact_id",
        "stderr_artifact_id"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "FileContent": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "path",
        "revision",
        "content"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "FileCreate": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "expected_workspace_revision": {
          "minimum": 0,
          "title": "Expected Workspace Revision",
          "type": "integer"
        },
        "client_operation_id": {
          "format": "uuid",
          "title": "Client Operation Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content",
        "expected_workspace_revision",
        "client_operation_id"
      ],
      "title": "FileCreate",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "revision"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "FileList": {
      "additionalProperties": false,
      "properties": {
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "workspace_revision",
        "files"
      ],
      "title": "FileList",
      "type": "object"
    },
    "FileMutation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "client_operation_id": {
          "format": "uuid",
          "title": "Client Operation Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "expected_revision",
        "client_operation_id"
      ],
      "title": "FileMutation",
      "type": "object"
    },
    "FileRename": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "client_operation_id": {
          "format": "uuid",
          "title": "Client Operation Id",
          "type": "string"
        },
        "destination": {
          "maxLength": 4096,
          "title": "Destination",
          "type": "string"
        }
      },
      "required": [
        "path",
        "expected_revision",
        "client_operation_id",
        "destination"
      ],
      "title": "FileRename",
      "type": "object"
    },
    "FileRevision": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "saved_at": {
          "format": "date-time",
          "title": "Saved At",
          "type": "string"
        }
      },
      "required": [
        "path",
        "revision",
        "workspace_revision",
        "content_sha256",
        "saved_at"
      ],
      "title": "FileRevision",
      "type": "object"
    },
    "FileWrite": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "title": "Path",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "client_operation_id": {
          "format": "uuid",
          "title": "Client Operation Id",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "path",
        "expected_revision",
        "client_operation_id",
        "content"
      ],
      "title": "FileWrite",
      "type": "object"
    },
    "FinalizeReview": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        }
      },
      "required": [
        "expected_revision"
      ],
      "title": "FinalizeReview",
      "type": "object"
    },
    "Invitation": {
      "additionalProperties": false,
      "properties": {
        "invitation_id": {
          "format": "uuid",
          "title": "Invitation Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "invitation_id",
        "expires_at"
      ],
      "title": "Invitation",
      "type": "object"
    },
    "InviteRequest": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id"
      ],
      "title": "InviteRequest",
      "type": "object"
    },
    "Liveness": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "alive",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Liveness",
      "type": "object"
    },
    "Rating": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "independent",
            "assisted"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "dimension",
        "score",
        "rationale",
        "evidence_ids"
      ],
      "title": "Rating",
      "type": "object"
    },
    "Readiness": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ready",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Readiness",
      "type": "object"
    },
    "RecordingConsent": {
      "additionalProperties": false,
      "properties": {
        "notice_version": {
          "minLength": 1,
          "title": "Notice Version",
          "type": "string"
        },
        "granted": {
          "title": "Granted",
          "type": "boolean"
        }
      },
      "required": [
        "notice_version",
        "granted"
      ],
      "title": "RecordingConsent",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "rubric_version": {
          "minLength": 1,
          "title": "Rubric Version",
          "type": "string"
        },
        "ratings": {
          "items": {
            "$ref": "#/$defs/Rating"
          },
          "title": "Ratings",
          "type": "array"
        },
        "integrity_controls": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Integrity Controls",
          "type": "array"
        },
        "limitations": {
          "items": {
            "minLength": 1,
